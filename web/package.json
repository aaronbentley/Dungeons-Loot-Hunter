{
    "name": "dungeons-loot-hunter",
    "version": "1.0.0",
    "private": true,
    "description": "dungeons-loot-hunter",
    "author": "AaronBentley",
    "keywords": [
        "gatsby"
    ],
    "scripts": {
        "dev": "ponysay --pony pinkie \"It's dev time\" && ENABLE_GATSBY_REFRESH_ENDPOINT=true && node node_modules/.bin/gatsby develop -H 0.0.0.0 -o",
        "build": "ponysay --pony rarity \"It's build time\" && gatsby build",
        "build-serve": "ponysay --pony fluttershy \"It's build-serve time\" && gatsby build && gatsby serve -H 0.0.0.0 -o",
        "clean": "gatsby clean"
    },
    "dependencies": {
        "@chakra-ui/gatsby-plugin": "^3.0.1",
        "@chakra-ui/icons": "^2.0.2",
        "@chakra-ui/react": "^2.2.1",
        "@emotion/react": "^11.9.0",
        "@emotion/styled": "^11.8.1",
        "@sanity/client": "^3.3.2",
        "@sanity/image-url": "^1.0.1",
        "a11y-react-emoji": "^1.2.0",
        "algoliasearch": "^4.13.1",
        "framer-motion": "^6.3.11",
        "gatsby": "^4.16.0",
        "gatsby-plugin-algolia": "^0.26.0",
        "gatsby-plugin-gdpr-cookies": "^2.0.9",
        "gatsby-plugin-google-analytics": "^4.16.0",
        "gatsby-plugin-image": "^2.16.1",
        "gatsby-plugin-manifest": "^4.16.0",
        "gatsby-plugin-react-helmet": "^5.16.0",
        "gatsby-plugin-sanity-image": "^0.11.0",
        "gatsby-plugin-sitemap": "^5.16.0",
        "gatsby-source-sanity": "^7.4.2",
        "react": "^18.1.0",
        "react-dom": "^18.1.0",
        "react-helmet": "^6.1.0",
        "react-instantsearch-hooks-web": "^6.27.0",
        "react-use": "^17.4.0",
        "slugify": "^1.6.5"
    },
    "devDependencies": {
        "dotenv": "^16.0.1",
        "eslint-config-prettier": "^8.4.0",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-prettier": "^4.0.0",
        "eslint-plugin-promise": "^6.0.0",
        "prettier": "2.6.2"
    }
}
