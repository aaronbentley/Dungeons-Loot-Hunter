{
  "name": "dungeons-loot-hunter",
  "version": "1.0.0",
  "private": true,
  "description": "dungeons-loot-hunter",
  "author": "AaronBentley",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "dev": "ponysay --pony pinkie \"It's dev time\" && node node_modules/.bin/gatsby develop -H 0.0.0.0 -o",
    "build": "ponysay --pony rarity \"It's build time\" && gatsby build",
    "build-serve": "ponysay --pony fluttershy \"It's build-serve time\" && gatsby build && gatsby serve -H 0.0.0.0 -o",
    "clean": "gatsby clean"
  },
  "dependencies": {
    "@chakra-ui/gatsby-plugin": "^3.0.0",
    "@chakra-ui/react": "^2.0.0",
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@sanity/client": "^3.3.0",
    "framer-motion": "^6.3.3",
    "gatsby": "^4.14.0",
    "gatsby-plugin-google-analytics": "^4.14.0",
    "gatsby-plugin-image": "^2.14.1",
    "gatsby-plugin-manifest": "^4.14.0",
    "gatsby-plugin-react-helmet": "^5.14.0",
    "gatsby-plugin-sanity-image": "^0.11.0",
    "gatsby-plugin-sitemap": "^5.14.0",
    "gatsby-source-sanity": "^7.4.2",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-helmet": "^6.1.0",
    "slugify": "^1.6.5"
  }
}
